# Copy to .env and fill real values. Never commit .env.
# DB_HOST/DB_PORT are for host PHP (localhost:3307 via port mapping).
# The app container uses db:3306 automatically (see docker-compose.yml).
DB_HOST=localhost
DB_PORT=3307
DB_NAME=aji_l3bo_cafe
DB_USER=cafe_app
DB_PASS=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Redis for rate limiting (docker service name or localhost)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# App
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8080
